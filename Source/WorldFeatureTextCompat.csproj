<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AssemblyName>WorldFeatureTextCompat17</AssemblyName>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">G:\Steam\steamapps\common\RimWorld</RimWorldDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(RimWorldDir)\System*.dll" Exclude="$(RimWorldDir)\System.IO.Compression.Native.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(RimWorldDir)/netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony" Condition="'$(HarmonyPath)' != ''">
      <HintPath>$(HarmonyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.2" Condition="'$(HarmonyPath)' == ''" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>
</Project>
